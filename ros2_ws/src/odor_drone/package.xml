<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>odor_drone</name>
  <version>0.2.0</version>
  <description>악취 드론 온보드(RPi5) 노드: Pixhawk 데이터 수집, 가스 센서(I2C 직결 또는 시리얼), 지오태깅, CSV/JSONL 로그</description>
  <maintainer email="dev@example.com">Drone_Stink team, selim-drone-proj</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>odor_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- mavros 와 I2C 라이브러리(smbus2, bme680)는 README 의 설치 절차로 따로 설치 -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
