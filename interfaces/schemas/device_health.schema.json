{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/selim-drone-proj/moving-ver/interfaces/schemas/device_health.schema.json",
  "title": "DeviceHealth",
  "description": "장비 상태(하트비트). 모든 장비가 /health/<장비 ID> 로 발행한다. - Pi5 장비(mob_01, ess_01): 10 초마다 - 고정형(fix_xx): 10 분마다 LoRa 로 보내고 게이트웨이가 대신 발행 - 게이트웨이(gw_01): 10 초마다 대시보드는 이 토픽으로 \"살아 있나, 센서가 다 붙어 있나\" 를 본다.",
  "type": "object",
  "properties": {
    "type": {
      "const": "device_health",
      "description": "기록 종류"
    },
    "version": {
      "const": "0.2",
      "description": "규격 버전"
    },
    "stamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC 시각, ISO 8601, 밀리초까지 (예: 2026-10-10T05:12:33.120Z)"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*_[0-9]{2}$",
      "description": "장비 ID. 소문자 + 밑줄 + 두 자리 번호 (mob_01, fix_01, ess_01, gw_01, octo_01)"
    },
    "state": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "enum": [
        0,
        1,
        2,
        3,
        4
      ],
      "description": "위 STATE_* (0 막 켜짐 ~ 4 측정 불가) | 0=BOOT, 1=WARMUP, 2=OK, 3=DEGRADED, 4=ERROR"
    },
    "firmware": {
      "type": "string",
      "description": "소프트웨어 이름과 버전 (예: fix_station 0.2.0)"
    },
    "uptime_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "켜진 뒤 경과 초"
    },
    "sensor_ok_mask": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "센서별 정상 비트. 비트 뜻은 장비마다 다름 (DATA_SPEC.md 4.6 표)"
    },
    "error_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "켜진 뒤 누적 오류 수"
    },
    "supply_v": {
      "type": [
        "number",
        "null"
      ],
      "description": "전원 전압 V. 모르면 NaN"
    },
    "cpu_temp_c": {
      "type": [
        "number",
        "null"
      ],
      "description": "CPU 온도 ℃ (Pi 만). 모르면 NaN"
    },
    "rssi_dbm": {
      "type": "integer",
      "minimum": -32768,
      "maximum": 32767,
      "description": "LoRa 수신 세기 dBm (게이트웨이가 채움). 0 = 모름"
    },
    "message": {
      "type": "string",
      "description": "최근 오류를 사람이 읽을 수 있게. 없으면 빈 문자열"
    }
  },
  "required": [
    "type",
    "version",
    "stamp",
    "device_id",
    "state",
    "firmware",
    "uptime_s",
    "sensor_ok_mask",
    "error_count",
    "supply_v",
    "cpu_temp_c",
    "rssi_dbm",
    "message"
  ],
  "additionalProperties": false,
  "$defs": {
    "body": {
      "type": "object",
      "properties": {
        "stamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC 시각, ISO 8601, 밀리초까지 (예: 2026-10-10T05:12:33.120Z)"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[0-9]{2}$",
          "description": "장비 ID. 소문자 + 밑줄 + 두 자리 번호 (mob_01, fix_01, ess_01, gw_01, octo_01)"
        },
        "state": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "enum": [
            0,
            1,
            2,
            3,
            4
          ],
          "description": "위 STATE_* (0 막 켜짐 ~ 4 측정 불가) | 0=BOOT, 1=WARMUP, 2=OK, 3=DEGRADED, 4=ERROR"
        },
        "firmware": {
          "type": "string",
          "description": "소프트웨어 이름과 버전 (예: fix_station 0.2.0)"
        },
        "uptime_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "켜진 뒤 경과 초"
        },
        "sensor_ok_mask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "센서별 정상 비트. 비트 뜻은 장비마다 다름 (DATA_SPEC.md 4.6 표)"
        },
        "error_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "켜진 뒤 누적 오류 수"
        },
        "supply_v": {
          "type": [
            "number",
            "null"
          ],
          "description": "전원 전압 V. 모르면 NaN"
        },
        "cpu_temp_c": {
          "type": [
            "number",
            "null"
          ],
          "description": "CPU 온도 ℃ (Pi 만). 모르면 NaN"
        },
        "rssi_dbm": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767,
          "description": "LoRa 수신 세기 dBm (게이트웨이가 채움). 0 = 모름"
        },
        "message": {
          "type": "string",
          "description": "최근 오류를 사람이 읽을 수 있게. 없으면 빈 문자열"
        }
      },
      "required": [
        "stamp",
        "device_id",
        "state",
        "firmware",
        "uptime_s",
        "sensor_ok_mask",
        "error_count",
        "supply_v",
        "cpu_temp_c",
        "rssi_dbm",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
