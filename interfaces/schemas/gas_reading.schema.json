{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/selim-drone-proj/moving-ver/interfaces/schemas/gas_reading.schema.json",
  "title": "GasReading",
  "description": "악취 센서 1회 측정값 (이동형, 고정형 공통) - 이동형: gas_i2c_node 가 /odor/gas 로 1 Hz 발행 (순간값) - 고정형: StationSample.gas 안에 들어감 (avg_window_s 동안의 평균) 규격 v0.2. v0.1 필드는 이름, 순서 그대로이고 뒤에 필드만 추가했다. 값이 없거나 그 장비에 없는 센서는 NaN (JSON 에서는 null, CSV 에서는 빈 칸).",
  "type": "object",
  "properties": {
    "type": {
      "const": "gas_reading",
      "description": "기록 종류"
    },
    "version": {
      "const": "0.2",
      "description": "규격 버전"
    },
    "stamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC 시각, ISO 8601, 밀리초까지 (예: 2026-10-10T05:12:33.120Z)"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*_[0-9]{2}$",
      "description": "장비 ID. 소문자 + 밑줄 + 두 자리 번호 (mob_01, fix_01, ess_01, gw_01, octo_01)"
    },
    "h2s_ppm": {
      "type": [
        "number",
        "null"
      ],
      "description": "황화수소 ppm"
    },
    "nh3_ppm": {
      "type": [
        "number",
        "null"
      ],
      "description": "암모니아 ppm"
    },
    "tvoc_ppb": {
      "type": [
        "number",
        "null"
      ],
      "description": "총휘발성유기화합물 ppb (SGP30. SGP41 은 이 값을 못 냄 -> NaN)"
    },
    "temperature_c": {
      "type": [
        "number",
        "null"
      ],
      "description": "측정 공기 온도 ℃"
    },
    "humidity_pct": {
      "type": [
        "number",
        "null"
      ],
      "description": "측정 공기 상대습도 0~100 %"
    },
    "pump_on": {
      "type": "boolean",
      "description": "흡입 펌프 동작 여부 (펌프 없는 장비는 false)"
    },
    "payload_voltage": {
      "type": [
        "number",
        "null"
      ],
      "description": "센서 모듈 전원 전압 V (측정 안 하면 NaN)"
    },
    "eco2_ppm": {
      "type": [
        "number",
        "null"
      ],
      "description": "SGP30 eCO2 추정값 ppm (실제 CO2 센서 아님)"
    },
    "voc_index": {
      "type": [
        "number",
        "null"
      ],
      "description": "SGP41 VOC Index 1~500, 평소 100. 단위 없음"
    },
    "nox_index": {
      "type": [
        "number",
        "null"
      ],
      "description": "SGP41 NOx Index 1~500, 평소 1. 단위 없음"
    },
    "pressure_hpa": {
      "type": [
        "number",
        "null"
      ],
      "description": "기압 hPa (BME688)"
    },
    "gas_resistance_ohm": {
      "type": [
        "number",
        "null"
      ],
      "description": "BME688 가스 저항 Ω (낮을수록 VOC 많음)"
    },
    "pm1_0_ugm3": {
      "type": [
        "number",
        "null"
      ],
      "description": "PMS7003 PM1.0 µg/m³ (대기 환산값)"
    },
    "pm2_5_ugm3": {
      "type": [
        "number",
        "null"
      ],
      "description": "PMS7003 PM2.5 µg/m³"
    },
    "pm10_ugm3": {
      "type": [
        "number",
        "null"
      ],
      "description": "PMS7003 PM10 µg/m³"
    },
    "nh3_raw": {
      "type": [
        "number",
        "null"
      ],
      "description": "NH3 원신호 (재보정용, 분석에는 쓰지 말 것). 고정형: 증폭 회로 출력 µV, 이동형: 온도 보정 전 ppm"
    },
    "h2s_raw": {
      "type": [
        "number",
        "null"
      ],
      "description": "H2S 원신호 (재보정용, 분석에는 쓰지 말 것). 고정형: 증폭 회로 출력 µV, 이동형: 온도 보정 전 ppm"
    },
    "flags": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "품질 비트 (아래 상수). 0 이면 모두 정상 | 비트: 1=WARMUP, 2=NH3_INVALID, 4=H2S_INVALID, 8=VOC_INVALID, 16=TH_INVALID, 32=PM_INVALID, 64=TIME_UNSYNCED, 128=ZERO_CAL, 256=PURGE, 512=PUMP_ON, 1024=TEMP_COMP, 2048=SIMULATED"
    }
  },
  "required": [
    "type",
    "version",
    "stamp",
    "device_id",
    "h2s_ppm",
    "nh3_ppm",
    "tvoc_ppb",
    "temperature_c",
    "humidity_pct",
    "pump_on",
    "payload_voltage",
    "eco2_ppm",
    "voc_index",
    "nox_index",
    "pressure_hpa",
    "gas_resistance_ohm",
    "pm1_0_ugm3",
    "pm2_5_ugm3",
    "pm10_ugm3",
    "nh3_raw",
    "h2s_raw",
    "flags"
  ],
  "additionalProperties": false,
  "$defs": {
