            "null"
          ],
          "description": "A, 방전 중일 때 양수"
        },
        "battery_percent": {
          "type": [
            "number",
            "null"
          ],
          "description": "0~100, FC 추정치. 모르면 -1"
        }
      },
      "required": [
        "stamp",
        "device_id",
        "armed",
        "mode",
        "in_air",
        "latitude",
        "longitude",
        "altitude_msl",
        "altitude_rel",
        "heading_deg",
        "gps_fix_type",
        "gps_satellites",
        "roll_deg",
        "pitch_deg",
        "yaw_deg",
        "ground_speed_mps",
        "climb_rate_mps",
        "battery_voltage",
        "battery_current",
        "battery_percent"
      ],
      "additionalProperties": false
    }
  }
}
