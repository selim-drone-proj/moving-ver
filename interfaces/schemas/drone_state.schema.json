{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/selim-drone-proj/moving-ver/interfaces/schemas/drone_state.schema.json",
  "title": "DroneState",
  "description": "드론 비행 컨트롤러(Pixhawk) 상태 요약 fc_state_node 가 mavros 토픽들을 모아서 /drone/state 로 10 Hz 발행한다.",
  "type": "object",
  "properties": {
    "type": {
      "const": "drone_state",
      "description": "기록 종류"
    },
    "version": {
      "const": "0.2",
      "description": "규격 버전"
    },
    "stamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC 시각, ISO 8601, 밀리초까지 (예: 2026-10-10T05:12:33.120Z)"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*_[0-9]{2}$",
      "description": "장비 ID. 소문자 + 밑줄 + 두 자리 번호 (mob_01, fix_01, ess_01, gw_01, octo_01)"
    },
    "armed": {
      "type": "boolean"
    },
    "mode": {
      "type": "string",
      "description": "비행모드 문자열 (예: LOITER, AUTO, GUIDED, RTL)"
    },
    "in_air": {
      "type": "boolean",
      "description": "공중이면 true, 지상이면 false"
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ],
      "description": "deg, WGS84. 모르면 NaN"
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ],
      "description": "deg. 모르면 NaN"
    },
    "altitude_msl": {
      "type": [
        "number",
        "null"
      ],
      "description": "m, 해수면 기준"
    },
    "altitude_rel": {
      "type": [
        "number",
        "null"
      ],
      "description": "m, 이륙 지점 기준"
    },
    "heading_deg": {
      "type": [
        "number",
        "null"
      ],
      "description": "0~360, 북쪽이 0, 시계방향 +"
    },
    "gps_fix_type": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "0~1: fix 없음, 2: 2D, 3: 3D, 4~6: DGPS/RTK"
    },
    "gps_satellites": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "사용 위성 수"
    },
    "roll_deg": {
      "type": [
        "number",
        "null"
      ]
    },
    "pitch_deg": {
      "type": [
        "number",
        "null"
      ]
    },
    "yaw_deg": {
      "type": [
        "number",
        "null"
      ],
      "description": "ENU 기준(동쪽이 0, 반시계 +). 방위는 heading_deg 를 쓸 것"
    },
    "ground_speed_mps": {
      "type": [
        "number",
        "null"
      ],
      "description": "m/s"
    },
    "climb_rate_mps": {
      "type": [
        "number",
        "null"
      ],
      "description": "m/s, 상승이 +"
    },
    "battery_voltage": {
      "type": [
        "number",
        "null"
      ],
      "description": "V"
    },
    "battery_current": {
      "type": [
        "number",
        "null"
      ],
      "description": "A, 방전 중일 때 양수"
    },
    "battery_percent": {
      "type": [
        "number",
        "null"
      ],
      "description": "0~100, FC 추정치. 모르면 -1"
    }
  },
  "required": [
    "type",
    "version",
    "stamp",
    "device_id",
    "armed",
    "mode",
    "in_air",
    "latitude",
    "longitude",
    "altitude_msl",
    "altitude_rel",
    "heading_deg",
    "gps_fix_type",
    "gps_satellites",
    "roll_deg",
    "pitch_deg",
    "yaw_deg",
    "ground_speed_mps",
    "climb_rate_mps",
    "battery_voltage",
    "battery_current",
    "battery_percent"
  ],
  "additionalProperties": false,
  "$defs": {
    "body": {
      "type": "object",
      "properties": {
        "stamp": {
          "type": "string",
          "format": "date-time",
