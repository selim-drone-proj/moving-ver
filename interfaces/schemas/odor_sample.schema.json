{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/selim-drone-proj/moving-ver/interfaces/schemas/odor_sample.schema.json",
  "title": "OdorSample",
  "description": "지오태깅된 악취 샘플 = 가스 측정값 + 그 순간의 드론 상태 (이동형) odor_sample_node 가 /odor/sample 로 발행한다 (가스 측정 1회당 1개, 1 Hz). 소프트웨어(모델, 대시보드)는 이동형 데이터를 이 토픽 하나로 받는다. 규격 v0.2: 맨 뒤에 drone_age_s 추가.",
  "type": "object",
  "properties": {
    "type": {
      "const": "odor_sample",
      "description": "기록 종류"
    },
    "version": {
      "const": "0.2",
      "description": "규격 버전"
    },
    "stamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC 시각, ISO 8601, 밀리초까지 (예: 2026-10-10T05:12:33.120Z)"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*_[0-9]{2}$",
      "description": "장비 ID. 소문자 + 밑줄 + 두 자리 번호 (mob_01, fix_01, ess_01, gw_01, octo_01)"
    },
    "drone": {
      "allOf": [
        {
          "$ref": "drone_state.schema.json#/$defs/body"
        }
      ],
      "description": "측정 순간의 드론 위치, 자세, 배터리"
    },
    "gas": {
      "allOf": [
        {
          "$ref": "gas_reading.schema.json#/$defs/body"
        }
      ],
      "description": "가스 측정값"
    },
    "drone_age_s": {
      "type": [
        "number",
        "null"
      ],
      "description": "붙인 드론 상태가 몇 초 전 것인지. 2 초를 넘으면 위치를 믿지 말 것"
    }
  },
  "required": [
    "type",
    "version",
    "stamp",
    "device_id",
    "drone",
    "gas",
    "drone_age_s"
  ],
  "additionalProperties": false,
  "$defs": {
    "body": {
      "type": "object",
      "properties": {
        "stamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC 시각, ISO 8601, 밀리초까지 (예: 2026-10-10T05:12:33.120Z)"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[0-9]{2}$",
          "description": "장비 ID. 소문자 + 밑줄 + 두 자리 번호 (mob_01, fix_01, ess_01, gw_01, octo_01)"
        },
        "drone": {
          "allOf": [
            {
              "$ref": "drone_state.schema.json#/$defs/body"
            }
          ],
          "description": "측정 순간의 드론 위치, 자세, 배터리"
        },
        "gas": {
          "allOf": [
            {
              "$ref": "gas_reading.schema.json#/$defs/body"
            }
          ],
          "description": "가스 측정값"
        },
        "drone_age_s": {
          "type": [
            "number",
            "null"
          ],
          "description": "붙인 드론 상태가 몇 초 전 것인지. 2 초를 넘으면 위치를 믿지 말 것"
        }
      },
      "required": [
        "stamp",
        "device_id",
        "drone",
        "gas",
        "drone_age_s"
      ],
      "additionalProperties": false
    }
  }
}
