{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/selim-drone-proj/moving-ver/interfaces/schemas/fire_status.schema.json",
  "title": "FireStatus",
  "description": "화재 감지기(ess_01) 상태. fire_detect 가 /fire/<id>/status 로 1 Hz 발행한다. 감시 대상: 소형 ESS(파워뱅크) 충전 중 과열. 센서 3종: 표면온도(AMG8833), 주변 온습도(SHT31), 연기(MQ-2)",
  "type": "object",
  "properties": {
    "type": {
      "const": "fire_status",
      "description": "기록 종류"
    },
    "version": {
      "const": "0.2",
      "description": "규격 버전"
    },
    "stamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC 시각, ISO 8601, 밀리초까지 (예: 2026-10-10T05:12:33.120Z)"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*_[0-9]{2}$",
      "description": "장비 ID. 소문자 + 밑줄 + 두 자리 번호 (mob_01, fix_01, ess_01, gw_01, octo_01)"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "enum": [
        0,
        1,
        2,
        3
      ],
      "description": "위 LEVEL_* 4 단계 (0 정상 ~ 3 위험) | 0=NORMAL, 1=CAUTION, 2=WARNING, 3=DANGER"
    },
    "latched": {
      "type": "boolean",
      "description": "위험 단계가 걸려 사람이 해제할 때까지 유지되는 중"
    },
    "ambient_temp_c": {
      "type": [
        "number",
        "null"
      ],
      "description": "주변 온도 ℃ (SHT31). 뜨거운 화소 판정의 기준선"
    },
    "ambient_rh_pct": {
      "type": [
        "number",
        "null"
      ],
      "description": "주변 상대습도 %"
    },
    "surface_max_c": {
      "type": [
        "number",
        "null"
      ],
      "description": "표면 64 화소 중 최고 ℃"
    },
    "surface_mean_c": {
      "type": [
        "number",
        "null"
      ],
      "description": "표면 64 화소 평균 ℃"
    },
    "surface_min_c": {
      "type": [
        "number",
        "null"
      ],
      "description": "표면 64 화소 중 최저 ℃"
    },
    "hot_pixels": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "(화소 온도 > 주변 + delta_c) 인 화소 개수 0~64"
    },
    "hotspot_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "최고 화소 위치 0~63 = 행 * 8 + 열. 255 = 없음"
    },
    "delta_c": {
      "type": [
        "number",
        "null"
      ],
      "description": "판정에 쓴 ΔT ℃ (설정값)"
    },
    "abs_limit_c": {
      "type": [
        "number",
        "null"
      ],
      "description": "판정에 쓴 절대 한계 ℃ (설정값)"
    },
    "smoke_v": {
      "type": [
        "number",
        "null"
      ],
      "description": "MQ-2 출력 전압 V (분압 보정 후 실제 AO 전압)"
    },
    "smoke_baseline_v": {
      "type": [
        "number",
        "null"
      ],
      "description": "깨끗한 공기 기준 전압 V (정상 단계에서 천천히 학습)"
    },
    "smoke_detected": {
      "type": "boolean",
      "description": "smoke_v 가 기준보다 설정값 이상 올라감"
    },
    "charge_allowed": {
      "type": "boolean",
      "description": "AC SSR 통전 중 = 충전 허용. false = 차단"
    },
    "dc_allowed": {
      "type": "boolean",
      "description": "DC 릴레이 통전 중"
    },
    "buzzer_on": {
      "type": "boolean",
      "description": "부저가 울리는 중 (연속 또는 간헐)"
    },
    "flags": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "아래 비트. bit6, bit11 은 GasReading 과 같은 뜻 | 비트: 1=SMOKE_WARMUP, 2=AMG_INVALID, 4=SHT_INVALID, 8=ADC_INVALID, 64=TIME_UNSYNCED, 2048=SIMULATED"
    },
    "thermal_c": {
      "type": "array",
      "items": {
        "type": [
          "number",
          "null"
        ]
      },
      "minItems": 64,
      "maxItems": 64,
      "description": "8x8 화소 온도 ℃, 행 우선 (0 번이 왼쪽 위)"
    }
  },
  "required": [
    "type",
    "version",
    "stamp",
    "device_id",
    "level",
    "latched",
    "ambient_temp_c",
    "ambient_rh_pct",
    "surface_max_c",
    "surface_mean_c",
    "surface_min_c",
    "hot_pixels",
    "hotspot_index",
    "delta_c",
    "abs_limit_c",
    "smoke_v",
    "smoke_baseline_v",
    "smoke_detected",
    "charge_allowed",
    "dc_allowed",
    "buzzer_on",
    "flags",
    "thermal_c"
  ],
  "additionalProperties": false,
  "$defs": {
